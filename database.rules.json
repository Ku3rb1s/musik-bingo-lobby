{
  "rules": {
    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || (!newData.exists() && (data.child('act').exists() ? data.child('act').val() : data.child('created').val()) < now - 86400000))",
        ".validate": "$code.matches(/^[A-Z0-9]{4,8}$/) && (!newData.exists() || newData.child('host').val() === auth.uid || newData.child('host').val() === data.child('host').val())",
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && data.parent().parent().child('bingo').exists()",
            ".validate": "newData.hasChildren(['name', 'num'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "num": {
              ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 9999"
            },
            "g": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "marks": {
              ".validate": "newData.hasChildren()",
              "$m": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24"
              }
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "bingo": {
              ".validate": "newData.isNumber()"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "ok": {
              ".validate": "newData.isBoolean() && (data.parent().parent().parent().child('host').val() === auth.uid || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            },
            "guess": {
              ".validate": "newData.hasChildren(['t', 'n']) && newData.child('t').isString() && newData.child('t').val().length <= 80 && newData.child('n').isNumber()"
            },
            "hr": {
              ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isNumber() && newData.child('t').isNumber()"
            },
            "bz": {
              ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isNumber() && newData.child('t').isNumber()"
            },
            "lm": {
              ".validate": "newData.hasChildren(['n', 'i']) && newData.child('n').isNumber() && newData.child('i').isNumber()"
            }
          }
        },
        "host": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "act": {
          ".validate": "newData.isNumber()"
        },
        "bingo": {
          ".validate": "newData.hasChildren(['g', 's', 'k'])",
          "g": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 5"
          },
          "f": {
            ".validate": "newData.isNumber() || newData.isBoolean()"
          },
          "z": {
            ".validate": "newData.isNumber() || newData.isBoolean()"
          },
          "k": {
            "$j": {
              ".validate": "newData.hasChildren(['i'])",
              "i": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "c": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "e": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "round": {
          "$f": {
            ".validate": "!newData.isString() || newData.val().length <= 500"
          }
        },
        "match": {
          "$f": {
            ".validate": "!newData.isString() || newData.val().length <= 500"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
